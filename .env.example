# Optional deployment overrides.
# Ordinary users do not need to set these.
SIGMA_OSM_OVERPASS_URL=
SIGMA_OSM_USER_AGENT=
SIGMA_LLM_MODEL=
SIGMA_LLM_BASE_URL=

# Optional OpenAI secret for explicit --llm runs.
# Do NOT put a real API key in this file or commit one to Git.
# setup.ps1 never reads or writes this variable.
# Only setup-llm.ps1 writes it, after an explicit user request.
SIGMA_LLM_API_KEY=
